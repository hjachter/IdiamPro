    "decision-pricing-ai-costsafety-verifier-2026-07-23": {
      "id": "decision-pricing-ai-costsafety-verifier-2026-07-23",
      "name": "Decisions 2026-07-23 — Pricing, AI cost-safety & verifier",
      "content": "<p><strong>2026-07-23 — Pricing model, server-side AI cost meter, and always-on verifier.</strong> Summary of decisions; details in the child notes below.</p>",
      "type": "document",
      "parentId": "17a29ec6-74ba-4196-8f2f-f7dc8a59f862",
      "childrenIds": [
